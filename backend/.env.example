# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── PostgreSQL ─────────────────────────────────────
DATABASE_URL=postgresql://agriconnect:agriconnect@localhost:5432/agriconnect?schema=public

# ── MongoDB ────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/agriconnect

# ── Redis ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ── Cloudinary (images) ────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=agriconnect

# ── Razorpay (payments) ────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Firebase (notifications) ───────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── Google Maps ────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Crop quality service (optional; bids fail open if unavailable) ──
QUALITY_SERVICE_URL=http://localhost:8001
QUALITY_INTERNAL_TOKEN=
QUALITY_SERVICE_TIMEOUT_MS=8000

# ── Market Price Intelligence & Weather (optional external providers) ──
# DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
# AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# ENAM_API_URL=
# ENAM_API_KEY=
# IMD_API_KEY=
# IMD_BEARER_TOKEN=
# MARKET_DATA_MODE=demo
